# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* values reach the browser — never put secrets in them.

# Base URL of the FastAPI backend (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared secret the API sends to /api/revalidate (Phase 3)
REVALIDATE_SECRET=

# Cloudflare Turnstile site key (public, Phase 6)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
