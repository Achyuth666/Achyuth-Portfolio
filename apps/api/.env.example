# Copy to .env and fill in. Never commit real values.

ENVIRONMENT=development
# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3100

# MongoDB Atlas (Phase 2)
MONGODB_URI=
MONGODB_DB=portfolio

# Admin + cron endpoints (long random strings)
ADMIN_TOKEN=
CRON_SECRET=

# Frontend on-demand revalidation (must match apps/web REVALIDATE_SECRET)
WEB_URL=http://localhost:3100
REVALIDATE_SECRET=

# LLMs + embeddings (Phase 5)
GROQ_API_KEY=
GEMINI_API_KEY=

# Email (Phase 7)
RESEND_API_KEY=
NOTIFY_EMAIL=

# Cloudflare Turnstile secret (Phase 6)
TURNSTILE_SECRET_KEY=

# GitHub sync (Phase 8)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_USERNAME=Achyuth666

# Hashing salt for visitor IPs
IP_HASH_SALT=
